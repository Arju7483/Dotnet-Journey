@model CityWeather

<!DOCTYPE html>
<html>
<head>
    <title>Weather</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>

<body>

    <div class="container">

        <div class="header">
            <h2>Weather</h2>
        </div>

        <div class="page-content text-center">

            <div class="box margin-auto w-25 margin-top-200">

                <div class="flex-borderless">

                    <div class="w-50 text-left">
                        <div>
                            <strong>@Model.CityName</strong>
                        </div>

                        <div class="text-grey">
                            @Model.DateAndTime.ToString("dd MMM yyyy")
                        </div>

                        <div class="text-grey">
                            @Model.DateAndTime.ToString("hh:mm tt")
                        </div>
                    </div>

                    <div class="w-50 text-right">
                        <span style="font-size:30px;font-weight:bold">
                            @Model.TemperatureFahrenheit
                        </span>
                        <span>°F</span>
                    </div>

                </div>

            </div>

            <div class="margin-top text-center">
                <a href="~/">Back to Weather Home Page</a>
            </div>

        </div>

    </div>

</body>
</html>